{
  "name": "attt",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.20.0",
  "prisma": {
    "schema": "packages/prisma/schema.prisma",
    "seed": "tsx packages/prisma/seed.ts"
  },
  "scripts": {
    "dev": "nuxi dev",
    "start": "nuxi start --port=3000",
    "build": "nuxi build",
    "generate": "nuxi generate",
    "prepare": "nuxi prepare",
    "typeCheck": "nuxi typecheck",
    "preview": "http-server ./.output/public",
    "test": "vitest run",
    "test:nuxt": "vitest run --config vitest.nuxt.config.ts",
    "test:nuxt:build": "vitest run --config vitest.nuxt.config.ts --mode production",
    "test:watch": "vitest",
    "test:update": "vitest run -u",
    "lint:js": "eslint .",
    "lint:style": "stylelint **/*.{vue,css} --ignore-path .gitignore",
    "lint": "pnpm lint:js && pnpm lint:style",
    "prettier": "prettier . --check --ignore-path .gitignore",
    "prettier:fix": "prettier . --write --ignore-path .gitignore"
  },
  "dependencies": {
    "@nuxt/eslint": "1.17.0",
    "@nuxt/fonts": "1.2.0",
    "@prisma/adapter-pg": "7.10.1",
    "@vuepic/vue-datepicker": "14.0.0",
    "@xmldom/xmldom": "0.9.12",
    "markdown-it": "15.0.3",
    "nuxt": "4.6.4",
    "pg": "8.23.1",
    "postcss": "8.5.32",
    "postcss-html": "2.0.0",
    "tailwindcss": "4.3.5",
    "unstorage": "1.17.6",
    "vue-router": "5.5.1",
    "vue-toast-notification": "3.1.3",
    "nuxt-auth-utils": "0.6.2"
  },
  "devDependencies": {
    "@nuxtjs/stylelint-module": "5.2.1",
    "@pinia/nuxt": "1.0.3",
    "@prisma/client": "7.10.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/eslint-config-prettier": "6.11.3",
    "@types/markdown-it": "14.2.0",
    "@types/pg": "8.23.1",
    "autoprefixer": "10.6.2",
    "dayjs": "1.11.23",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "http-server": "14.1.1",
    "nuxt-gtag": "5.0.0",
    "pinia": "4.1.0",
    "postcss": "8.5.32",
    "prettier": "3.10.1",
    "prisma": "7.10.1",
    "sass": "1.108.2",
    "simple-icons": "16.38.0",
    "stylelint": "18.0.0",
    "stylelint-config-standard": "41.0.0",
    "stylelint-config-standard-scss": "18.0.0",
    "stylelint-scss": "7.5.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.0",
    "vue-material-design-icons": "5.4.0",
    "vue-tsc": "3.3.14",
    "zod": "4.6.7"
  }
}
