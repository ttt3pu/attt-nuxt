{
  "extends": ["github>ttt3pu/renovate-settings"],
  "cloneSubmodules": true,
  "cloneSubmodulesFilter": ["packages/prisma"],
  "packageRules": [
    {
      "description": "Automerge @xmldom/xmldom minor/patch when tests pass",
      "matchPackageNames": ["@xmldom/xmldom"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "description": "Automerge prisma / pg minor/patch when tests pass",
      "matchPackageNames": ["prisma", "@prisma/client", "@prisma/adapter-pg", "pg"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "description": "Keep pnpm/action-setup at v4 for pnpm v10 (migrate to pnpm/setup when upgrading to pnpm v11)",
      "matchPackageNames": ["pnpm/action-setup"],
      "allowedVersions": "^4.0.0"
    }
  ]
}
