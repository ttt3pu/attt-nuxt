{
  "extends": ["github>ttt3pu/renovate-settings"],
  "cloneSubmodules": true,
  "cloneSubmodulesFilter": ["packages/prisma"],
  "git-submodules": {
    "enabled": true
  },
  "ignoreDeps": ["packages/resume"],
  "packageRules": [
    {
      "description": "Automerge @nuxt/fonts minor/patch when production font delivery tests pass",
      "matchPackageNames": ["@nuxt/fonts"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "description": "Automerge unstorage minor/patch when production build tests pass",
      "matchPackageNames": ["unstorage"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "description": "Group and automerge pinia minor/patch when tests pass",
      "matchPackageNames": ["pinia", "@pinia/nuxt"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "pinia",
      "automerge": true
    },
    {
      "description": "Automerge zod minor/patch when tests pass",
      "matchPackageNames": ["zod"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "description": "Automerge nuxt minor/patch when tests pass",
      "matchPackageNames": ["nuxt"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "description": "Automerge markdown-it minor/patch when tests pass",
      "matchPackageNames": ["markdown-it"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "description": "Disable minimumReleaseAge and enable automerge for git submodules when tests pass",
      "matchManagers": ["git-submodules"],
      "minimumReleaseAge": null,
      "automerge": true
    },
    {
      "description": "Automerge @xmldom/xmldom minor/patch when tests pass",
      "matchPackageNames": ["@xmldom/xmldom"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "description": "Automerge prisma / pg minor/patch when tests pass",
      "matchPackageNames": ["prisma", "@prisma/client", "@prisma/adapter-pg", "pg"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "description": "Automerge vue-router minor/patch when tests pass",
      "matchPackageNames": ["vue-router"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "description": "Automerge pnpm minor/patch when CI passes",
      "matchPackageNames": ["pnpm"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "description": "Automerge simple-icons minor/patch when tests pass",
      "matchPackageNames": ["simple-icons"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "description": "Automerge css related packages minor/patch when tests pass",
      "matchPackageNames": ["sass", "autoprefixer", "postcss", "tailwindcss", "@tailwindcss/postcss"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    }
  ]
}
