  }
}
@media (width <= 768px) {
  .mouth::before, .mouth::after {
    height: 0.8463541667vh;
  }
}
@media (width <= 568px) {
  .mouth::before, .mouth::after {
    height: 0.7161458333vh;
  }
}
.mouth::before {
  left: 100%;
  transform: rotate(15deg);
}
.mouth::after {
  right: 100%;
  transform: rotate(-15deg) scale(-1, 1);
}

.mouth-line {
  position: absolute;
