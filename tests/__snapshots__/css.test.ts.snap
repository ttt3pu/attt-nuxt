  animation-delay: 0.45s;
}
@media (width >= 1601px) {
  .cat-mascot__heart--4 {
    font-size: 61.2px;
  }
}
@media (width <= 1600px) {
  .cat-mascot__heart--4 {
    font-size: 4.5vw;
  }
}
@media (width <= 768px) {
