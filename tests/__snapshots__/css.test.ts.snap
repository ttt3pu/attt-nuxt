.mouth::before, .mouth::after {
  position: absolute;
  display: block;
  content: "";
  background-color: #121212;
  transition: transform 0.22s ease;
}
@media (width >= 1601px) {
  .mouth::before, .mouth::after {
    width: 51px;
  }
}
@media (width <= 1600px) {
  .mouth::before, .mouth::after {
