/* おやつキャッチ連動 — 喜びは口は通常のまま＋周囲ハート。怒りのみ口形状を変える */
.cat-mascot--react-hurt .mouth {
  transform: translateY(4px);
}
.cat-mascot--react-hurt .mouth::before {
  transform: rotate(26deg);
}
.cat-mascot--react-hurt .mouth::after {
  transform: rotate(-26deg) scale(-1, 1);
}

.cat-mascot--react-hurt .mouth-line {
  transform: scaleY(1.12);
}

/* 喜び：猫の周りのハート */
.cat-mascot__heart {
  position: absolute;
  z-index: 10;
  pointer-events: none;
  color: #fec6db;
  text-shadow: 0 0 6px rgba(249, 248, 113, 0.45);
  animation: cat-heart-float 0.9s ease-in-out infinite;
}
@media (width >= 1601px) {
  .cat-mascot__heart {
    font-size: 71.4px;
  }
}
@media (width <= 1600px) {
  .cat-mascot__heart {
    font-size: 5.25vw;
  }
}
@media (width <= 768px) {
  .cat-mascot__heart {
    font-size: 7.109375vh;
  }
}
@media (width <= 568px) {
  .cat-mascot__heart {
    font-size: 6.015625vh;
  }
}

.cat-mascot__heart--1 {
  top: 4%;
  left: 8%;
  animation-delay: 0s;
}

.cat-mascot__heart--2 {
  top: 8%;
  right: 6%;
  animation-delay: 0.15s;
}

.cat-mascot__heart--3 {
  top: 38%;
  left: 2%;
  animation-delay: 0.3s;
}
@media (width >= 1601px) {
  .cat-mascot__heart--3 {
    font-size: 54.4px;
  }
}
@media (width <= 1600px) {
  .cat-mascot__heart--3 {
    font-size: 4vw;
  }
}
@media (width <= 768px) {
  .cat-mascot__heart--3 {
    font-size: 5.4166666667vh;
  }
}
@media (width <= 568px) {
  .cat-mascot__heart--3 {
    font-size: 4.5833333333vh;
  }
}

.cat-mascot__heart--4 {
  top: 32%;
  right: 2%;
  animation-delay: 0.45s;
}
@media (width >= 1601px) {
  .cat-mascot__heart--4 {
    font-size: 61.2px;
  }
}
@media (width <= 1600px) {
  .cat-mascot__heart--4 {
    font-size: 4.5vw;
  }
}
@media (width <= 768px) {
  .cat-mascot__heart--4 {
    font-size: 6.09375vh;
  }
}
@media (width <= 568px) {
  .cat-mascot__heart--4 {
    font-size: 5.15625vh;
  }
}

@keyframes cat-heart-float {
  0%, 100% {
    transform: translateY(0) scale(1);
    opacity: 0.75;
  }
  50% {
    transform: translateY(-8px) scale(1.08);
    opacity: 1;
  }
}
/* 怒り：周囲の「どんより」渦（白縁＋紫線の SVG。猫の色は変えない） */
.cat-mascot__gloom-spin {
  position: absolute;
  z-index: 10;
  width: 18%;
  height: 22%;
  min-width: 2.5rem;
  min-height: 2.8rem;
  pointer-events: none;
  animation: cat-gloom-spin-float 2.2s ease-in-out infinite;
}

.cat-mascot__gloom-spin--1 {
  top: 3%;
  left: 2%;
  animation-delay: 0s;
}

.cat-mascot__gloom-spin--2 {
  top: 8%;
  right: 0%;
  animation-delay: 0.35s;
}

.cat-mascot__gloom-spin--3 {
  top: 36%;
  left: -2%;
  animation-delay: 0.15s;
}

.cat-mascot__gloom-spin--4 {
  top: 30%;
  right: -1%;
  animation-delay: 0.5s;
}

.cat-mascot__gloom-spin--5 {
  top: 52%;
  left: 14%;
  animation-delay: 0.75s;
}

.cat-mascot__gloom-svg {
  display: block;
  width: 100%;
  height: 100%;
  overflow: visible;
}

.cat-mascot__gloom-outline {
  stroke: #fff;
  stroke-width: 10;
  paint-order: stroke fill;
}

.cat-mascot__gloom-line {
  stroke: #7d6b9a;
  stroke-width: 4;
}

@keyframes cat-gloom-spin-float {
  0%, 100% {
    transform: translate(0, 0) scale(1);
    opacity: 0.82;
  }
  50% {
    transform: translate(2px, -4px) scale(1.04);
    opacity: 0.98;
  }
}
@media (prefers-reduced-motion: reduce) {
  .mouth,
  .mouth::before,
  .mouth::after,
  .mouth-line {
    transition-duration: 0.01ms;
  }
  .cat-mascot__heart {
    animation: none;
    opacity: 0.9;
  }
  .cat-mascot__gloom-spin {
    animation: none;
    opacity: 0.88;
  }
}"
`;

exports[`プロダクトのスタイルシートおよびCSS処理パイプライン > SassによるプロダクトSCSSのコンパイル > mixins.scss の line-height-crop mixin が正しく擬似要素と計算式を展開すること 1`] = `
".test-crop::before {
  display: block;
  width: 0;
  height: 0;
  margin-top: calc((1 - 1.5) * 0.5em);
  content: "";
}
.test-crop::after {
  display: block;
  width: 0;
  height: 0;
  margin-bottom: calc((1 - 1.5) * 0.5em);
  content: "";
}"
`;

exports[`プロダクトのスタイルシートおよびCSS処理パイプライン > SassによるプロダクトSCSSのコンパイル > 共通SCSS（common.scss）がコンパイルされ、変数計算やmixin展開が正しく行われること 1`] = `
"html {
  --line-height: 2;
  --line-height-heading: 1.5;
  --font-family-en: 'Poppins', sans-serif;
  --font-family-jp: 'Noto Sans JP', sans-serif;
  --txt-color-white: #e2f1ff;
  --txt-color-white-lv2: #939ca5;
  --txt-color-link: #fff7d6;
  --txt-color-link-hover: hsl(48.2926829268, 100%, 101.9607843137%);
  --color-gray: #666;
  --primary-color: #f9f871;
  --secondary-color: #ffb962;
  --tertiary-color: #b95d7b;
  --padding-lr-pc: 5.0505050505vw;
  --padding-lr-sp: 5.0505050505vw;
  --max-width: 1600px;
  --gray-color: #aaaabc;
  --vh: 1vh;
  --z-init: 0;
  --z-cat: 1;
  --z-cat-layer: 2;
  --z-title: 3;
  --z-sns: 4;
  --z-scroll: 5;
  --z-language: 6;
  font-family: sans-serif;
  font-size: 16px;
  word-spacing: 1px;
  -ms-text-size-adjust: 100%;
  -webkit-text-size-adjust: 100%;
  -moz-osx-font-smoothing: grayscale;
  -webkit-font-smoothing: antialiased;
  box-sizing: border-box;
  line-height: var(--line-height);
  scroll-behavior: smooth;
}

body {
  background-color: var(--color-bg);
  min-height: calc(100 * var(--vh));
}

ul {
  list-style: none;
  margin: 0;
  padding: 0;
}

a {
  text-decoration: none;
}

*,
*::before,
*::after {
  box-sizing: border-box;
  margin: 0;
}"
`;
