  }
}
@media (width <= 568px) {
  .cat-mascot__heart {
    font-size: 6.015625vh;
  }
}

.cat-mascot__heart--1 {
  top: 4%;
  left: 8%;
  animation-delay: 0s;
}

.cat-mascot__heart--2 {
  top: 8%;
  right: 6%;
  animation-delay: 0.15s;
}

